# Google Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Fallback model when rate limited
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Supabase database configuration (direct connection string or API keys)
# Note: For direct SQL operations and migrations, DB_COOP_URL is the PostgreSQL URI.
DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Triage configuration
AUTO_APPROVAL_CEILING=5000.0  # Max net price for auto-approval (in currency units)
PRICE_DEVIATION_THRESHOLD=0.15  # 15% price deviation allowed
NEW_VENDOR_THRESHOLD_DAYS=90  # Days threshold to consider a vendor 'new'
DUPLICATE_WINDOW_DAYS=30  # Rolling window in days for duplicate checks
CONFIDENCE_THRESHOLD=0.80  # Minimum confidence score threshold for auto-actions
